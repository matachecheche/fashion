# Configuracion del microservicio de IA y Ciencia de Datos (FastAPI)
APP_ENV=development
PORT=8000
DATABASE_URL=postgresql://USER:REPLACE_ME@127.0.0.1:5432/fashionstore
DATABASE_SSL=false
IA_INTERNAL_KEY=REPLACE_WITH_SHARED_RANDOM_INTERNAL_KEY
# Proveedores LLM opcionales (el sistema descubre modelos compatibles; usa reglas locales si no hay claves)
# Groq: gsk_... | Gemini: AIza... o AQ.Ab8R... (cabecera x-goog-api-key)
GROQ_API_KEY=REPLACE_WITH_GROQ_API_KEY
GROQ_MODEL=auto
GEMINI_API_KEY=
GEMINI_MODEL=auto
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
