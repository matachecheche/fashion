# Configuracion del microservicio de IA y Ciencia de Datos (FastAPI)
APP_ENV=development
PORT=8000
DATABASE_URL=postgresql://USER:REPLACE_ME@127.0.0.1:5432/fashionstore
DATABASE_SSL=false
IA_INTERNAL_KEY=REPLACE_WITH_SHARED_RANDOM_INTERNAL_KEY
# Proveedores LLM opcionales (el sistema opera con motor determinista seguro si estan vacios)
GROQ_API_KEY=REPLACE_WITH_GROQ_API_KEY
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
