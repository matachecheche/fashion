# URL base del API comercial NestJS. En desarrollo local use:
#   - Emulador Android:  http://10.0.2.2:3000/api
#   - Dispositivo físico: http://<IP-de-la-PC>:3000/api
# En producción/Azure debe ser HTTPS (ej: https://fashionstore-api-xxxx.azurecontainerapps.io/api)
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api
EXPO_PUBLIC_DEFAULT_TENANT_SLUG=legacy
