# Configuracion de la API Comercial Multi-Tenant (NestJS)
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://USER:REPLACE_ME@127.0.0.1:5432/fashionstore
DATABASE_SSL=false
JWT_SECRET=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
JWT_EXPIRES_IN=12h
PAGOS_MODO=sandbox
# Stripe Checkout real de prueba: ambas credenciales se guardan solo en el servidor.
STRIPE_SECRET_KEY=rk_test_REPLACE_FROM_STRIPE_TEST_DASHBOARD
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_FROM_STRIPE_TEST_WEBHOOK
# Solo firma del simulador local antiguo; NO es una clave de webhook de Stripe.
STRIPE_SIMULATOR_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_LOCAL_SIMULATOR_SECRET
LIBELULA_APP_KEY=REPLACE_WITH_LIBELULA_SANDBOX_APP_KEY
LIBELULA_WEBHOOK_SECRET=REPLACE_WITH_LIBELULA_SANDBOX_WEBHOOK_SECRET
FASTAPI_URL=http://127.0.0.1:8000
IA_INTERNAL_KEY=REPLACE_WITH_SHARED_RANDOM_INTERNAL_KEY
PUBLIC_API_URL=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081
